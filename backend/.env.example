# 数据库连接（当前环境为便携版 PostgreSQL + psycopg2）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/clearning

# JWT 签名密钥（生产环境务必替换为强随机值）
SECRET_KEY=dev-only-secret-change-in-production

# 允许的跨域来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI 配置（M6 阶段使用；密钥只存服务端，永远不要写到前端）
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
